{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"driver,owner,admin\" -c \"cyan,emerald,purple\" \"npm run dev:driver\" \"npm run dev:owner\" \"npm run dev:admin\"",
    "dev:driver": "vite --config vite.driver.config.ts",
    "dev:owner": "vite --config vite.owner.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:driver": "vite build --config vite.driver.config.ts",
    "build:owner": "vite build --config vite.owner.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build": "npm run build:driver && npm run build:owner && npm run build:admin",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}

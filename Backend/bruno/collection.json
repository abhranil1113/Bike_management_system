{
  "name": "Bike Management System API Collection",
  "version": "1.0.0",
  "items": [
    {
      "name": "Auth",
      "items": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "headers": { "Content-Type": "application/json" },
            "body": "{\"full_name\":\"John Doe\",\"email\":\"johndoe@example.com\",\"phone\":\"9876543210\",\"password\":\"Secret123!\",\"confirm_password\":\"Secret123!\",\"role\":\"driver\"}"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "headers": { "Content-Type": "application/json" },
            "body": "{\"email\":\"johndoe@example.com\",\"password\":\"Secret123!\"}"
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token",
            "headers": { "Content-Type": "application/json" },
            "body": "{\"refresh_token\":\"{{refreshToken}}\"}"
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "headers": { "Authorization": "Bearer {{accessToken}}" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
            "headers": { "Content-Type": "application/json" },
            "body": "{\"email\":\"johndoe@example.com\"}"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset-password",
            "headers": { "Content-Type": "application/json" },
            "body": "{\"reset_token\":\"{{resetToken}}\",\"new_password\":\"NewSecret123!\",\"confirm_password\":\"NewSecret123!\"}"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/change-password",
            "headers": { "Authorization": "Bearer {{accessToken}}", "Content-Type": "application/json" },
            "body": "{\"current_password\":\"Secret123!\",\"new_password\":\"NewSecret123!\",\"confirm_password\":\"NewSecret123!\"}"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "headers": { "Authorization": "Bearer {{accessToken}}" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "items": [
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard",
            "headers": { "Authorization": "Bearer {{adminToken}}" }
          }
        },
        {
          "name": "Approve/Reject Owner",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/verify-owner/{{ownerId}}",
            "headers": { "Authorization": "Bearer {{adminToken}}", "Content-Type": "application/json" },
            "body": "{\"approved\": true}"
          }
        },
        {
          "name": "Approve/Reject Bike",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/verify-bike/{{bikeId}}",
            "headers": { "Authorization": "Bearer {{adminToken}}", "Content-Type": "application/json" },
            "body": "{\"approved\": true}"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "items": [
        {
          "name": "Get My Wallet",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/me",
            "headers": { "Authorization": "Bearer {{accessToken}}" }
          }
        },
        {
          "name": "Create Wallet Recharge Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet/recharge/create-order",
            "headers": { "Authorization": "Bearer {{accessToken}}", "Content-Type": "application/json" },
            "body": "{\"amount\": 1000.00}"
          }
        }
      ]
    }
  ]
}
